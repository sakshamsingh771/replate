# Copy to .env and change every secret. Never commit .env.
POSTGRES_USER=replate
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=replate
DATABASE_URL=postgresql+psycopg://replate:change-me-db-password@db:5432/replate

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_REFRESH_SECRET=

ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: RePlate works without it (rule-based explanations are used).
LLM_API_KEY=

SIMULATOR_ENABLED=true
SIMULATOR_INTERVAL_SECONDS=90
